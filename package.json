{
  "name": "shopkart-workspace",
  "version": "1.0.0",
  "description": "ShopKart — Full-Stack MERN E-Commerce Platform",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "backend": "npm --prefix backend run start",
    "backend:dev": "npm --prefix backend run dev",
    "seed": "npm --prefix backend run seed",
    "frontend": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  }
}
